# Copy to .env and adjust. Never commit .env.
ONCO_ENV=local
ONCO_STORAGE_BACKEND=local          # local | s3
ONCO_S3_BUCKET=oncoinsight-raw
ONCO_S3_ENDPOINT_URL=http://localhost:9010   # SeaweedFS S3 locally; leave empty for AWS S3
AWS_ACCESS_KEY_ID=oncoinsight
AWS_SECRET_ACCESS_KEY=oncoinsight-secret
AWS_REGION=us-east-1

WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_DB=oncoinsight
WAREHOUSE_USER=oncoinsight
WAREHOUSE_PASSWORD=oncoinsight
WAREHOUSE_READER_USER=onco_reader
WAREHOUSE_READER_PASSWORD=onco_reader

# Optional: enables the AI analytics assistant
ANTHROPIC_API_KEY=
ONCO_ASSISTANT_MODEL=claude-opus-5

# KPI monitoring thresholds
ONCO_KPI_ALERT_PCT_CHANGE=0.25
ONCO_KPI_ALERT_MIN_N=8

# Optional: require X-API-Key on the REST API (leave empty to disable)
ONCO_API_KEY=
